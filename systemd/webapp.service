[Unit]
Description=Cloud Native Web Application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=csye6225
Group=csye6225
WorkingDirectory=/opt/webapp

Environment="DB_HOST=localhost"
Environment="DB_PORT=5432"
Environment="DB_NAME=webapp_db"
Environment="DB_USER=keerthanadevigovindaraj"
Environment="DB_PASSWORD=password123"
Environment="APP_HOST=0.0.0.0"
Environment="APP_PORT=8080"
Environment="PATH=/opt/webapp/venv/bin"

ExecStart=/opt/webapp/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080

Restart=on-failure
RestartSec=10s

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target